#!/bin/sh
# 1) Ninguém faz push na main: toda mudança entra por pull request (.agents/harness.config, seção 1).
# 2) Todo push de branch só sai com testes e build passando (.agents/harness.config, seção 2).
# Ativado pelo `npm install` (scripts/instalar-hooks.mjs). Não use --no-verify para contornar.
verificar=0
shas=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Push na main bloqueado. Crie uma branch, faça push dela e abra um pull request." >&2
    exit 1
  fi
  # Apagar branch remota (sha local zerado) não tem o que verificar.
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) verificar=1; shas="$shas $local_sha" ;;
  esac
done

if [ "$verificar" = "1" ]; then
  echo "pre-push: rodando a verificação antes de enviar..." >&2
  npm test -- --no-watch || { echo "pre-push: falhou: npm test -- --no-watch. Push cancelado." >&2; exit 1; }
  npm run build || { echo "pre-push: falhou: npm run build. Push cancelado." >&2; exit 1; }
  for sha in $shas; do
    node scripts/carimbo.mjs gerar "$sha" "$1" >&2 || { echo "pre-push: não consegui gravar o carimbo no remoto. Push cancelado." >&2; exit 1; }
  done
fi
exit 0
